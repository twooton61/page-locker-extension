{
  "manifest_version": 3,
  "name": "page-locker",
  "description": "Persist navigation confirmation locks for selected URLs.",
  "version": "0.3.1",
  "icons": {
    "16": "icons/page-16.png",
    "32": "icons/page-32.png",
    "48": "icons/page-48.png",
    "128": "icons/page-128.png"
  },
  "permissions": [
    "contextMenus",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/page-16.png",
      "32": "icons/page-32.png",
      "48": "icons/page-48.png",
      "128": "icons/page-128.png"
    },
    "default_title": "Page Locker: click to lock this URL"
  }
}
